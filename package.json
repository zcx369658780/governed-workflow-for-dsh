{
  "name": "dsh-governed-workflow",
  "version": "0.1.0",
  "description": "Policy-enforced, evidence-first governed workflows for DeepSeek Harness agents — installable community plugin (governance core + authority provider)",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./evidence-service": "./lib/evidence-service.js",
    "./guard-service": "./lib/guard-service.js",
    "./governed-builder-skill": "./lib/governed-builder-skill.js",
    "./github-issue-provider": "./lib/github-issue-provider.js",
    "./github-issue-authority-service": "./lib/github-issue-authority-service.js",
    "./lifecycle-tool-service": "./lib/lifecycle-tool-service.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "unknown"
    },
    "permissions": [
      "harness:tool",
      "harness:skill",
      "harness:guard",
      "session:append",
      "network:read",
      "credentials:none",
      "subprocess:none",
      "native-code:none"
    ],
    "compatibility": {
      "dshVersions": ["0.1.0-rc.6"]
    },
    "capability": {
      "id": "governance-status",
      "kind": "tool",
      "invocation": "invoke the model-facing tool named governance_status with empty arguments through the DSH ToolRuntime",
      "expected": "a bounded read-only object with fields state (lifecycle state), authorityAccepted (boolean), taskId (string|null), and a last-transition summary"
    },
    "evidence": {
      "install": "docs/OMDSH_REVIEW.md",
      "failureIsolation": null,
      "hotReload": null,
      "remove": "docs/OMDSH_REVIEW.md"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
